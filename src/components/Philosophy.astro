---
import { leadershipPillars } from '../data/philosophy';
import { Users, Cpu, TrendingUp, CheckCircle2, Sparkles } from 'lucide-astro';

const iconMap = {
  'people-first': Users,
  'pragmatic-tech': Cpu,
  'business-alignment': TrendingUp
};
---

<section id="philosophy" class="py-20 md:py-28 border-b border-zinc-800/60 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900 border border-zinc-700/80 text-xs font-mono text-zinc-300 mb-4">
        <Sparkles class="w-3.5 h-3.5 text-indigo-400" />
        Leadership Framework
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        How I Lead: People, Architecture, and Business Delivery.
      </h2>
      <p class="mt-4 text-base sm:text-lg text-zinc-400 leading-relaxed">
        Great CTOs and Engineering Managers don't just dictate architecture or track Jira tickets. They create an environment where engineers feel safe, inspired, and directly connected to customer value.
      </p>
    </div>

    <!-- Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {leadershipPillars.map((pillar) => {
        const IconComponent = iconMap[pillar.id as keyof typeof iconMap] || Users;
        return (
          <div class="group relative rounded-2xl bg-zinc-900/60 border border-zinc-800/80 p-7 hover:border-zinc-700 transition-all duration-300 hover:shadow-xl hover:shadow-indigo-950/20 flex flex-col justify-between">
            <div>
              <!-- Icon & Header -->
              <div class="w-12 h-12 rounded-xl bg-zinc-800/80 border border-zinc-700/80 flex items-center justify-center text-indigo-400 group-hover:bg-indigo-600 group-hover:text-white transition-colors duration-300 mb-6">
                <IconComponent class="w-6 h-6" />
              </div>

              <h3 class="text-xl font-bold text-white mb-2 group-hover:text-indigo-200 transition-colors">
                {pillar.title}
              </h3>
              <p class="text-sm font-medium text-zinc-400 mb-6 leading-relaxed">
                {pillar.subtitle}
              </p>

              <!-- Principles List -->
              <div class="space-y-4 pt-4 border-t border-zinc-800">
                {pillar.principles.map((principle) => (
                  <div class="space-y-1">
                    <div class="flex items-start gap-2">
                      <CheckCircle2 class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" />
                      <h4 class="text-xs font-semibold text-zinc-200 uppercase tracking-wider font-mono">
                        {principle.heading}
                      </h4>
                    </div>
                    <p class="text-xs text-zinc-400 pl-6 leading-relaxed">
                      {principle.description}
                    </p>
                  </div>
                ))}
              </div>
            </div>

            <!-- Bottom Accent Line -->
            <div class="mt-8 pt-4 border-t border-zinc-800/60 flex items-center justify-between text-[11px] font-mono text-zinc-500">
              <span>Pillar Approach</span>
              <span class="text-indigo-400/80">Continuous Practice</span>
            </div>
          </div>
        );
      })}
    </div>

    <!-- The Management Quote Box -->
    <div class="mt-12 p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-zinc-900/90 via-indigo-950/20 to-zinc-900/90 border border-zinc-800/90 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-1 text-center md:text-left">
        <span class="text-xs font-mono text-indigo-400 uppercase tracking-wider">The Core Conviction</span>
        <blockquote class="text-base sm:text-lg text-zinc-200 font-medium italic">
          "I manage people not because I grew tired of code, but because scaling people scales business impact. Having built high-load systems myself means I can lead engineers with authentic technical empathy."
        </blockquote>
      </div>
      <div class="shrink-0">
        <a
          href="#experience"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-xs font-mono text-zinc-200 border border-zinc-700 transition-colors"
        >
          View Timeline →
        </a>
      </div>
    </div>

  </div>
</section>
