---
// CV emblem matching the double-line badge from the original document
---
<div class="inline-flex items-center justify-center">
  <svg class="w-16 h-11 max-w-[70px]" width="64" height="40" viewBox="0 0 80 50" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="CV Emblem">
    <!-- Outer rounded contour -->
    <rect x="2" y="2" width="76" height="46" rx="14" stroke="#27272a" stroke-width="2.5" fill="none" />
    <!-- Inner subtle border -->
    <rect x="5.5" y="5.5" width="69" height="39" rx="11" stroke="#3f3f46" stroke-width="1.2" stroke-opacity="0.6" fill="none" />
    <!-- "CV" Typography styled with double-line aesthetic -->
    <text
      x="50%"
      y="55%"
      dominant-baseline="middle"
      text-anchor="middle"
      font-family="ui-monospace, 'JetBrains Mono', 'Courier New', monospace"
      font-size="28"
      font-weight="900"
      letter-spacing="1"
      fill="none"
      stroke="#18181b"
      stroke-width="2.5"
    >
      CV
    </text>
    <text
      x="50%"
      y="55%"
      dominant-baseline="middle"
      text-anchor="middle"
      font-family="ui-monospace, 'JetBrains Mono', 'Courier New', monospace"
      font-size="28"
      font-weight="900"
      letter-spacing="1"
      fill="#27272a"
      stroke="#ffffff"
      stroke-width="0.8"
    >
      CV
    </text>
  </svg>
</div>
