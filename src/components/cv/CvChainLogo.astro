---
// Chain logo featuring 4 interconnected colored nodes (yellow, green, dark teal, red)
---
<div class="inline-flex items-center justify-center my-1.5" aria-hidden="true">
  <svg class="w-36 h-7 max-w-[140px]" width="140" height="28" viewBox="0 0 140 32" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Link 1: Lime/Yellow (left node to node 2) -->
    <path
      d="M 16 6 L 46 6 A 10 10 0 0 1 46 26 L 16 26 A 10 10 0 0 1 16 6 Z"
      fill="#d4df37"
    />
    <!-- Link 2: Leaf Green (node 2 to node 3) -->
    <path
      d="M 46 6 L 76 6 A 10 10 0 0 1 76 26 L 46 26 A 10 10 0 0 1 46 6 Z"
      fill="#8bc34a"
    />
    <!-- Link 3: Dark Teal / Slate (node 3 to node 4) -->
    <path
      d="M 76 6 L 106 6 A 10 10 0 0 1 106 26 L 76 26 A 10 10 0 0 1 76 6 Z"
      fill="#37474f"
    />
    <!-- Link 4: Red-Orange cap -->
    <circle cx="106" cy="16" r="10" fill="#e53935" />
    <path
      d="M 106 6 L 122 6 A 10 10 0 0 1 122 26 L 106 26 Z"
      fill="#e53935"
    />

    <!-- Pivot pin holes (centers of the chain links) -->
    <circle cx="16" cy="16" r="5" fill="#ffffff" />
    <circle cx="46" cy="16" r="5" fill="#ffffff" />
    <circle cx="76" cy="16" r="5" fill="#ffffff" />
    <circle cx="106" cy="16" r="5" fill="#ffffff" />
    <circle cx="122" cy="16" r="5" fill="#ffffff" />
  </svg>
</div>
