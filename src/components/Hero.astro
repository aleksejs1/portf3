---
import { Image } from 'astro:assets';
import profilePhoto from '../assets/profile.jpg';
import { ArrowDown, ArrowUpRight, Mail } from 'lucide-astro';
import { yearsInTech, yearsInLeadership } from '../data/experience';
---

<section id="about" class="pt-12 pb-20 md:pt-20 md:pb-28 border-b border-zinc-800/60 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Narrative, Positioning & Impact Stats -->
      <div class="lg:col-span-7 flex flex-col space-y-6">
        
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-950/60 border border-indigo-700/50 text-indigo-300 text-xs font-mono w-fit">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Engineering Leader &amp; Future CTO
        </div>

        <!-- Main Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.12]">
          Scaling high-performing teams with a <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-300 via-sky-300 to-indigo-200 font-black">deep engineering backbone</span>.
        </h1>

        <!-- Executive Narrative -->
        <p class="text-lg text-zinc-300 leading-relaxed max-w-2xl">
          With <strong class="text-white font-medium">{yearsInTech} years</strong> in the tech industry, I spent a decade building mission-critical core banking architectures and high-load web systems before deliberately transitioning into people leadership.
        </p>

        <p class="text-base text-zinc-400 leading-relaxed max-w-2xl">
          I manage technical teams on their own terms: with deep architectural empathy, zero guesswork, and a relentless focus on growing autonomous, psychologically safe engineering groups that deliver business impact.
        </p>

        <!-- Impact Stat Chips -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
          <div class="p-3.5 rounded-xl bg-zinc-900/70 border border-zinc-800 flex flex-col">
            <span class="text-2xl font-bold font-mono text-white">{yearsInTech}</span>
            <span class="text-xs text-zinc-300 font-medium mt-1">Years in Tech</span>
          </div>
          <div class="p-3.5 rounded-xl bg-zinc-900/70 border border-zinc-800 flex flex-col">
            <span class="text-2xl font-bold font-mono text-indigo-400">{yearsInLeadership}</span>
            <span class="text-xs text-zinc-300 font-medium mt-1">Years in Leadership</span>
          </div>
          <div class="p-3.5 rounded-xl bg-zinc-900/70 border border-zinc-800 flex flex-col">
            <span class="text-2xl font-bold font-mono text-emerald-400">Millions</span>
            <span class="text-xs text-zinc-300 font-medium mt-1">Scale (inbox.lv)</span>
          </div>
          <div class="p-3.5 rounded-xl bg-zinc-900/70 border border-zinc-800 flex flex-col">
            <span class="text-2xl font-bold font-mono text-sky-400">Banking</span>
            <span class="text-xs text-zinc-300 font-medium mt-1">&amp; IoT Telematics</span>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="pt-4 flex flex-wrap items-center gap-3">
          <a
            href="https://www.linkedin.com/in/kovalovs-lv"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-sm transition-all hover:scale-[1.02] active:scale-[0.98] shadow-lg shadow-indigo-950/40"
          >
            Connect on LinkedIn <ArrowUpRight class="w-4 h-4" />
          </a>
          <a
            href="#experience"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-700/80 text-zinc-200 font-medium text-sm transition-all hover:border-zinc-500"
          >
            Career Journey <ArrowDown class="w-4 h-4 text-zinc-400" />
          </a>
          <a
            href="#contact"
            class="inline-flex items-center gap-2 px-4 py-3 rounded-xl text-zinc-400 hover:text-white font-mono text-xs transition-colors"
          >
            <Mail class="w-4 h-4 text-indigo-400" />
            aleksejs0@gmail.com
          </a>
        </div>

      </div>

      <!-- Right Column: Executive Portrait & Status Card -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="relative w-full max-w-sm sm:max-w-md group">
          <!-- Backlight Ambient Glow -->
          <div class="absolute -inset-1.5 bg-gradient-to-tr from-indigo-600/30 via-sky-500/20 to-emerald-500/30 rounded-3xl blur-2xl opacity-60 group-hover:opacity-80 transition duration-700"></div>

          <!-- Main Portrait Card with Executive Dark Frame Bezel -->
          <div class="relative rounded-3xl p-1.5 bg-gradient-to-b from-zinc-700/50 via-zinc-800/40 to-zinc-900/80 border border-zinc-700/70 shadow-2xl">
            <div class="relative rounded-2xl overflow-hidden bg-zinc-950">
              <!-- Image with controlled aspect ratio -->
              <div class="aspect-[3/4] overflow-hidden bg-zinc-950 relative">
                <Image
                  src={profilePhoto}
                  alt="Aleksejs Kovaļovs - Engineering Leader"
                  width={800}
                  height={1067}
                  format="webp"
                  quality={92}
                  class="w-full h-full object-cover object-top transition duration-500 group-hover:scale-[1.02]"
                />
                <!-- Soft Dark Vignette Overlays to Seamlessly Blend Light Studio Edges -->
                <div class="absolute inset-0 bg-gradient-to-b from-zinc-950/70 via-transparent to-zinc-950 pointer-events-none z-10"></div>
                <div class="absolute inset-0 bg-gradient-to-r from-zinc-950/60 via-transparent to-zinc-950/60 pointer-events-none z-10"></div>
                <div class="absolute inset-0 [background:radial-gradient(ellipse_75%_65%_at_50%_35%,transparent_45%,rgba(9,9,11,0.85)_100%)] pointer-events-none z-10"></div>
              </div>

              <!-- Floating Overlay Card info -->
              <div class="absolute bottom-0 inset-x-0 p-5 backdrop-blur-md bg-zinc-950/85 border-t border-zinc-800/80 z-20">
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="text-base font-semibold text-white">Aleksejs Kovaļovs</h3>
                    <p class="text-xs font-mono text-zinc-400 mt-0.5">Engineering Manager @ Mapon</p>
                  </div>
                  <div class="w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-sm shadow-emerald-500/50 animate-ping"></div>
                </div>

                <div class="mt-3 pt-3 border-t border-zinc-800/60 flex items-center justify-between text-[11px] font-mono text-zinc-400">
                  <span class="flex items-center gap-1.5 text-zinc-300">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    Riga, Latvia (On-site)
                  </span>
                  <span class="text-indigo-300">Open to CTO Roles</span>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
