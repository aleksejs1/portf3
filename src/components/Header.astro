---
import { ArrowUpRight, Menu, X } from 'lucide-astro';
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-zinc-950/80 border-b border-zinc-800/60 transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand & Live Status -->
    <a href="#" class="flex items-center gap-3 group">
      <div class="w-8 h-8 rounded-lg bg-zinc-900 border border-zinc-700/80 flex items-center justify-center text-sm font-bold text-indigo-400 group-hover:border-indigo-500/60 transition-colors">
        AK
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-semibold text-zinc-100 group-hover:text-white transition-colors">Aleksejs Kovaļovs</span>
        <span class="text-[11px] text-zinc-400 font-mono flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          Engineering Leader
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-zinc-400">
      <a href="#about" class="px-3 py-1.5 rounded-md hover:text-zinc-100 hover:bg-zinc-900/80 transition-colors">About</a>
      <a href="#philosophy" class="px-3 py-1.5 rounded-md hover:text-zinc-100 hover:bg-zinc-900/80 transition-colors">Philosophy</a>
      <a href="#experience" class="px-3 py-1.5 rounded-md hover:text-zinc-100 hover:bg-zinc-900/80 transition-colors">Experience</a>
      <a href="#projects" class="px-3 py-1.5 rounded-md hover:text-zinc-100 hover:bg-zinc-900/80 transition-colors">Engineering & Projects</a>
      <a href="#writing" class="px-3 py-1.5 rounded-md hover:text-zinc-100 hover:bg-zinc-900/80 transition-colors">Writing</a>
    </nav>

    <!-- CTA & Social Quick Links -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="https://www.linkedin.com/in/kovalovs-lv"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-mono text-zinc-400 hover:text-zinc-200 transition-colors flex items-center gap-0.5"
      >
        LinkedIn <ArrowUpRight class="w-3 h-3" />
      </a>
      <a
        href="#contact"
        class="inline-flex items-center justify-center px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white shadow-sm shadow-indigo-950 transition-all hover:scale-[1.02] active:scale-[0.98]"
      >
        Get in Touch
      </a>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      aria-label="Toggle navigation menu"
      class="md:hidden p-2 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-900 rounded-lg transition-colors"
    >
      <Menu class="w-5 h-5 block" id="icon-menu" />
      <X class="w-5 h-5 hidden" id="icon-close" />
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-zinc-800 bg-zinc-950/95 px-4 pt-2 pb-5 space-y-1 backdrop-blur-xl">
    <a href="#about" class="mobile-nav-link block px-3 py-2 rounded-md text-base font-medium text-zinc-300 hover:text-white hover:bg-zinc-900">About</a>
    <a href="#philosophy" class="mobile-nav-link block px-3 py-2 rounded-md text-base font-medium text-zinc-300 hover:text-white hover:bg-zinc-900">Philosophy</a>
    <a href="#experience" class="mobile-nav-link block px-3 py-2 rounded-md text-base font-medium text-zinc-300 hover:text-white hover:bg-zinc-900">Experience</a>
    <a href="#projects" class="mobile-nav-link block px-3 py-2 rounded-md text-base font-medium text-zinc-300 hover:text-white hover:bg-zinc-900">Engineering & Projects</a>
    <a href="#writing" class="mobile-nav-link block px-3 py-2 rounded-md text-base font-medium text-zinc-300 hover:text-white hover:bg-zinc-900">Writing</a>
    <div class="pt-3 border-t border-zinc-800/80 flex items-center justify-between">
      <a href="https://www.linkedin.com/in/kovalovs-lv" target="_blank" class="text-sm font-mono text-zinc-400 hover:text-white flex items-center gap-1">
        LinkedIn <ArrowUpRight class="w-3.5 h-3.5" />
      </a>
      <a href="#contact" class="mobile-nav-link px-4 py-2 text-xs font-semibold rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white">
        Get in Touch
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    if (isHidden) {
      menu?.classList.remove('hidden');
      iconMenu?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    } else {
      menu?.classList.add('hidden');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    }
  });

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
