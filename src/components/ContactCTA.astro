---
import { Mail, Linkedin, Send, Github, MapPin, Copy, Check, ArrowUpRight } from 'lucide-astro';
---

<section id="contact" class="py-20 md:py-28 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="rounded-3xl bg-gradient-to-b from-zinc-900 via-zinc-900/90 to-zinc-950 border border-zinc-700/70 p-8 sm:p-12 lg:p-16 relative overflow-hidden shadow-2xl">
      
      <!-- Background Ambient Glow -->
      <div class="absolute -top-32 right-0 w-96 h-96 bg-indigo-600/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-32 left-0 w-96 h-96 bg-emerald-600/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl">
        
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-950/80 border border-indigo-700/60 text-indigo-300 text-xs font-mono mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Leadership &amp; Advisory Conversations
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Ready to scale your engineering organization?
        </h2>

        <p class="mt-4 text-base sm:text-lg text-zinc-300 leading-relaxed">
          I am actively open to <strong class="text-white font-semibold">Chief Technology Officer (CTO)</strong>, <strong class="text-white font-semibold">VP of Engineering</strong>, or advisory discussions with ambitious startups and scale-ups looking for a steady, hands-on leader who knows how to inspire teams and ship resilient software.
        </p>

        <!-- Location Badge -->
        <div class="mt-6 flex items-center gap-2 text-xs font-mono text-zinc-400">
          <MapPin class="w-4 h-4 text-emerald-400" />
          <span>Based in Riga, Latvia • Open to On-site Leadership &amp; Executive Roles</span>
        </div>

        <!-- Contact Links Grid -->
        <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <!-- Email Card with Copy Button -->
          <div class="p-5 rounded-2xl bg-zinc-950/80 border border-zinc-800 hover:border-zinc-700 transition-all flex items-center justify-between group">
            <div class="flex items-center gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-zinc-900 border border-zinc-800 flex items-center justify-center text-indigo-400">
                <Mail class="w-5 h-5" />
              </div>
              <div>
                <span class="text-[11px] font-mono text-zinc-500 uppercase">Direct Email</span>
                <a href="mailto:aleksejs0@gmail.com" class="block text-sm font-semibold text-white hover:text-indigo-400 transition-colors">
                  aleksejs0@gmail.com
                </a>
              </div>
            </div>
            <button
              id="copy-email-btn"
              type="button"
              aria-label="Copy email address"
              class="p-2 text-zinc-500 hover:text-white rounded-lg hover:bg-zinc-800 transition-colors"
              title="Copy to clipboard"
            >
              <Copy class="w-4 h-4 block" id="copy-icon" />
              <Check class="w-4 h-4 text-emerald-400 hidden" id="check-icon" />
            </button>
          </div>

          <!-- LinkedIn Card -->
          <a
            href="https://www.linkedin.com/in/kovalovs-lv"
            target="_blank"
            rel="noopener noreferrer"
            class="p-5 rounded-2xl bg-zinc-950/80 border border-zinc-800 hover:border-zinc-700 transition-all flex items-center justify-between group hover:shadow-lg"
          >
            <div class="flex items-center gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-zinc-900 border border-zinc-800 flex items-center justify-center text-indigo-400">
                <Linkedin class="w-5 h-5" />
              </div>
              <div>
                <span class="text-[11px] font-mono text-zinc-500 uppercase">LinkedIn Profile</span>
                <span class="block text-sm font-semibold text-white group-hover:text-indigo-400 transition-colors">
                  in/kovalovs-lv
                </span>
              </div>
            </div>
            <ArrowUpRight class="w-4 h-4 text-zinc-500 group-hover:text-white transition-colors" />
          </a>

          <!-- Telegram Card -->
          <a
            href="https://t.me/kovalovs_lv"
            target="_blank"
            rel="noopener noreferrer"
            class="p-5 rounded-2xl bg-zinc-950/80 border border-zinc-800 hover:border-zinc-700 transition-all flex items-center justify-between group hover:shadow-lg"
          >
            <div class="flex items-center gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-zinc-900 border border-zinc-800 flex items-center justify-center text-sky-400">
                <Send class="w-5 h-5" />
              </div>
              <div>
                <span class="text-[11px] font-mono text-zinc-500 uppercase">Telegram Messenger</span>
                <span class="block text-sm font-semibold text-white group-hover:text-sky-400 transition-colors">
                  @kovalovs_lv
                </span>
              </div>
            </div>
            <ArrowUpRight class="w-4 h-4 text-zinc-500 group-hover:text-white transition-colors" />
          </a>

          <!-- GitHub Card -->
          <a
            href="https://github.com/aleksejs1"
            target="_blank"
            rel="noopener noreferrer"
            class="p-5 rounded-2xl bg-zinc-950/80 border border-zinc-800 hover:border-zinc-700 transition-all flex items-center justify-between group hover:shadow-lg"
          >
            <div class="flex items-center gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-zinc-900 border border-zinc-800 flex items-center justify-center text-emerald-400">
                <Github class="w-5 h-5" />
              </div>
              <div>
                <span class="text-[11px] font-mono text-zinc-500 uppercase">GitHub Activity</span>
                <span class="block text-sm font-semibold text-white group-hover:text-emerald-400 transition-colors">
                  github.com/aleksejs1
                </span>
              </div>
            </div>
            <ArrowUpRight class="w-4 h-4 text-zinc-500 group-hover:text-white transition-colors" />
          </a>

        </div>

      </div>
    </div>

  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyIcon = document.getElementById('copy-icon');
  const checkIcon = document.getElementById('check-icon');

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('aleksejs0@gmail.com');
      copyIcon?.classList.add('hidden');
      checkIcon?.classList.remove('hidden');
      setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
      }, 2000);
    } catch (e) {
      console.error(e);
    }
  });
</script>
